# Entorno: "true" = Ollama local, "false" = Groq + HuggingFace
USE_LOCAL=true

# Vault
VAULT_PATH=/ruta/absoluta/a/tu/vault

# Ollama (solo si USE_LOCAL=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq (solo si USE_LOCAL=false)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace embeddings (solo si USE_LOCAL=false)
HF_EMBED_MODEL=nomic-ai/nomic-embed-text-v1

# Modo solo lectura — desactiva create_note y edit_note (recomendado en producción)
READONLY_MODE=false

# ChromaDB
CHROMA_PERSIST_DIR=data/chroma_db

# Chunking
CHUNKER_STRATEGY=fixed
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Logging
LOG_LEVEL=INFO
